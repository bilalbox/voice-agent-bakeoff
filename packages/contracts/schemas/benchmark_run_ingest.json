{
	"$ref": "#/definitions/benchmark_run_ingest",
	"definitions": {
		"benchmark_run_ingest": {
			"type": "object",
			"properties": {
				"run_id": {
					"type": "string"
				},
				"architecture": {
					"type": "string",
					"enum": ["retell", "livekit", "cloudflare", "elevenlabs"]
				},
				"scenario_id": {
					"type": "string",
					"description": "Scenario identifier, e.g. sarah_reschedule, omar_cancel_fee, pool_heater_decline"
				},
				"summary": {
					"type": "string"
				},
				"policy_passed": {
					"type": "boolean",
					"description": "Whether all policy checks passed in this run"
				},
				"task_completed": {
					"type": "boolean",
					"description": "Whether the caller's primary task or scenario objective was resolved"
				},
				"resolution_turns": {
					"type": "integer",
					"minimum": 0,
					"description": "Number of assistant turns taken to reach resolution"
				},
				"tools_called_count": {
					"type": "integer",
					"minimum": 0,
					"description": "Total number of backend CRM tools invoked"
				},
				"tool_accuracy_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 100,
					"description": "Accuracy score (0-100) for tool selection and arguments"
				},
				"effectiveness_score": {
					"type": "number",
					"minimum": 0,
					"maximum": 100,
					"description": "Composite agent effectiveness score (0-100) combining policy fidelity, task resolution, tool accuracy, and turn efficiency"
				},
				"assertions_passed": {
					"type": "integer",
					"minimum": 0
				},
				"total_assertions": {
					"type": "integer",
					"minimum": 0
				},
				"evaluation_details": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"description": {
								"type": "string"
							},
							"passed": {
								"type": "boolean"
							},
							"reason": {
								"type": "string"
							}
						},
						"required": ["id", "description", "passed", "reason"],
						"additionalProperties": false
					}
				},
				"total_duration_ms": {
					"type": "number",
					"minimum": 0
				},
				"provenance": {
					"type": "string",
					"enum": ["live_webrtc", "edge_simulation"]
				},
				"turns": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"turn_index": {
								"type": "integer",
								"minimum": 0
							},
							"vad_ms": {
								"type": "number",
								"minimum": 0,
								"description": "Speech detection / End-of-Utterance latency in ms"
							},
							"stt_ms": {
								"type": "number",
								"minimum": 0,
								"description": "Speech-to-text transcription latency in ms"
							},
							"llm_ttft_ms": {
								"type": "number",
								"minimum": 0,
								"description": "LLM Time-to-First-Token in ms"
							},
							"tool_ms": {
								"type": "number",
								"minimum": 0,
								"description": "Mid-call tool execution latency in ms"
							},
							"tts_ttfb_ms": {
								"type": "number",
								"minimum": 0,
								"description": "TTS Time-to-First-Byte in ms"
							},
							"total_turn_rtt_ms": {
								"type": "number",
								"minimum": 0,
								"description": "Total ear-to-mouth turn latency in ms"
							},
							"client_rtt_ms": {
								"type": "number",
								"minimum": 0,
								"description": "Client-observed ear-to-mouth or request RTT in ms"
							},
							"prompt_tokens": {
								"type": "integer",
								"minimum": 0
							},
							"completion_tokens": {
								"type": "integer",
								"minimum": 0
							},
							"audio_input_seconds": {
								"type": "number",
								"minimum": 0
							},
							"audio_output_seconds": {
								"type": "number",
								"minimum": 0
							},
							"cost_usd": {
								"type": "number",
								"minimum": 0,
								"description": "Calculated cost in USD for this turn"
							},
							"tool_called": {
								"type": ["string", "null"]
							},
							"tool_args": {
								"type": "object",
								"additionalProperties": {}
							},
							"tool_result": {
								"type": "object",
								"additionalProperties": {}
							},
							"policy_verdict": {
								"type": "string",
								"enum": ["pass", "fail", "neutral"]
							},
							"transcript_user": {
								"type": "string"
							},
							"transcript_agent": {
								"type": "string"
							}
						},
						"required": ["turn_index", "total_turn_rtt_ms"],
						"additionalProperties": false
					}
				}
			},
			"required": ["architecture", "scenario_id", "policy_passed", "turns"],
			"additionalProperties": false
		}
	},
	"$schema": "http://json-schema.org/draft-07/schema#"
}
