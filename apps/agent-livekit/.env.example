# LiveKit Cloud Project Credentials (Required for LiveKit Cloud Inference)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Edge Backend Base URL
EDGE_BASE_URL=https://applianceops-edge.23p.workers.dev

# Retell (if this worker calls Retell APIs)
RETELL_API_KEY=
DEMO_VOICE_TOKEN=

# LiveKit Cloud Inference Models (Uses LiveKit API key, no external keys needed!)
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2-flash
LIVEKIT_LLM_MODEL=openai/gpt-6-luna

# Optional: Direct Provider Key Overrides (BYOK)
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
