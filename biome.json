{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/node_modules",
			"!!**/.wrangler",
			"!!**/pnpm-lock.yaml",
			"!!.rev-dep.baseline.json",
			"!!.rev-dep.duplicates.json",
			"!!**/tools/quality/ratchets",
			"!!**/worker-configuration.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": { "level": "on", "fix": "safe" }
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"noUnsafeReturn": "error",
				"useExhaustiveSwitchCases": "error"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useTemplate": { "level": "on", "fix": "safe" }
			},
			"suspicious": {
				"noConsole": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"scripts/**",
				"**/scripts/**",
				"tests/**",
				"**/tests/**",
				"**/*.test.*",
				"**/*.spec.*"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
